{
  "$schema": "../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../dist/sushi",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "input": "generated",
      "glob": "styles.css",
      "output": "."
    },
    {
      "input": ".",
      "glob": "README.md",
      "output": "."
    },
    {
      "input": ".",
      "glob": "LICENSE",
      "output": "."
    }
  ]
}
