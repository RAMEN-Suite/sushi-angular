{
  "name": "sushi-kit",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run generate:api && ng serve playground",
    "test": "ng test sushi --no-watch && npm run test:tools",
    "test:coverage": "ng test sushi --no-watch --coverage",
    "test:watch": "ng test sushi",
    "test:tools": "vitest run tools",
    "test:e2e": "npm run build:playground && playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "npm run build:playground && playwright test --config e2e/playwright.config.ts --ui",
    "verify": "npm run lint && npm run format && npm run test:coverage && npm run test:tools && npm run test:e2e && npm run package:check",
    "lint": "ng lint && eslint \"tools/**/*.ts\" \"e2e/**/*.ts\"",
    "generate:api": "node --import tsx tools/generate-api-reference.ts",
    "build:styles": "node --import tsx tools/build-library-styles.ts",
    "build:sushi": "npm run build:styles && ng build sushi",
    "package:smoke": "ng build playground --configuration package",
    "package:install": "bash tools/package-install-smoke.sh",
    "package:check": "npm run build:sushi && npm pack ./dist/sushi --dry-run --cache .cache/npm && npm run package:smoke && npm run package:install",
    "build:playground": "npm run generate:api && ng build playground",
    "format": "prettier --check . --ignore-unknown",
    "format:fix": "prettier --write . --ignore-unknown",
    "preview:playground": "npx serve dist/playground/browser -l 4201 -s"
  },
  "private": true,
  "engines": {
    "node": ">=26.3.0 <27",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/aria": "^22.1.2",
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@lucide/angular": "^1.31.0",
    "marked": "^16.4.2",
    "photoswipe": "^5.4.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "daisyui": "^5.7.16",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.0.1",
    "ng-packagr": "^22.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
